# Публичный адрес сайта — нужен ТОЛЬКО при self-host за reverse-proxy (см.
# lib/site-url.ts): без него редиректы middleware (/login и т.п.) уезжают
# на внутренний bind-адрес процесса вместо реального домена. На Vercel не
# нужен (там request.url и так корректен), для локальной разработки тоже
# не нужен (Next.js сам знает свой http://localhost:3000).
SITE_URL=https://media-watch.ru

# Supabase — обязательно
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role — нужен крону проверки новых серий
# (src/app/api/cron/check-episodes, читает user_list ВСЕХ пользователей) И
# регистрации (src/app/api/signup — создаёт пользователя через
# auth.admin.createUser в обход публичного signUp, см. SIGNUP_CODE_SECRET
# ниже). Берётся в Supabase: Project Settings → API → service_role.
# СЕКРЕТНЫЙ ключ — никогда не должен попасть в клиентский код/NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Секрет крона: Vercel сам добавляет заголовок Authorization: Bearer
# $CRON_SECRET к запросам по расписанию (см. vercel.json) — этим же
# значением эндпоинт /api/cron/check-episodes отличает настоящий крон-вызов
# от постороннего запроса. Сгенерируйте любую случайную строку.
CRON_SECRET=

# Kodik — опционально (Режим A: серверное проксирование поиска плеера).
# Токен бесплатный, выдаётся по запросу. Без него включается fallback (Режим B).
# Также используется как каталог раздела «Фильмы и сериалы» (эндпоинты /list и
# /search): без токена этот раздел показывает заглушку. Кладите значение в .env.local.
KODIK_TOKEN=

# Videoseed — основной плеер раздела «Фильмы и сериалы».
# Это «Ключ API плеера» из кабинета Videoseed (НЕ «Ключ API» — тот для apiv2.php,
# который мы не используем). Подставляется в ?token= в embed_auto по kinopoisk_id.
# Без него в кино доступен только Kodik (переключатель плеера скрыт).
# ВНИМАНИЕ: по дизайну провайдера этот токен попадает в src iframe и виден в
# браузере — это публичный embed-токен, так и задумано.
VIDEOSEED_TOKEN=

# Videoseed API v2 — каталог раздела «Фильмы и сериалы» (список/поиск/карточка).
# Это «Ключ API» из кабинета (32 символа), НЕ ключ плеера. Ходит на apiv2.php.
# Без него раздел кино показывает заглушку. Учтите: у API есть квота запросов,
# поэтому ответы кэшируются.
VIDEOSEED_API_TOKEN=

# Опционально: домен Videoseed, привязанный к аккаунту (виден в «Шаблоне
# embed-кода» в кабинете). По умолчанию tv-1-kinoserial.net.
VIDEOSEED_HOST=

# Vibix — плеер с ТОЧНЫМ трекингом позиции (его Playerjs шлёт postMessage-события).
# Bearer-токен API из личного кабинета vibix.org (формат id|секрет). Приватный,
# используется только на сервере (/api/v1/publisher/videos/kp/{kpId}).
# Без него пункт Vibix в переключателе плеера не показывается.
VIBIX_TOKEN=

# TMDB (themoviedb.org) — источник рейтинга для категорий кино с rankByRating
# («Зарубежные сериалы», «Русские сериалы»): у Videoseed своего рейтинга нет.
# Бесплатный API-ключ (v3 auth): themoviedb.org/settings/api. Без него эти
# категории просто показывают тайтлы в порядке Videoseed, без сортировки.
TMDB_API_KEY=

# Секрет кода приглашения — обязателен, иначе регистрация заблокирована для
# всех (fail closed, см. src/lib/signupCode.ts). Код на сегодня выводится из
# HMAC(секрет, дата UTC) — детерминированно, без БД и крона на ротацию.
# Сгенерируйте любую случайную строку (например: openssl rand -hex 32).
# ВАЖНО: в Supabase Dashboard → Authentication → Settings отключите "Allow
# new users to sign up" — иначе обычный signUp() всё ещё доступен напрямую
# через публичный anon key в обход этого кода (см. api/signup/route.ts).
SIGNUP_CODE_SECRET=

# ────────────────────────────────────────────────
# Собственный плеер (прокси-стриминг, см. §12 ARCHITECTURE.md)
# ────────────────────────────────────────────────

# HMAC-секрет для подписи внутренних URL сегментов/плейлистов HLS, которые
# /api/proxy отдаёт браузеру (см. src/lib/extract). Без него /api/proxy/raw
# отклоняет все запросы (не даёт превратиться в открытый SSRF-прокси).
# Сгенерируйте любую случайную строку.
PROXY_SIGNING_SECRET=

# Извлечение прямых ссылок теперь идёт через отдельный VPS-сервис
# (vps-extractor/ в этом репозитории, см. его README.md и §12.6
# ARCHITECTURE.md за полную историю расследования — почему server-side
# извлечение внутри Vercel serverless не проходит антибот источников, а
# обычный Puppeteer на VPS проходит).
#
# VPS_EXTRACTOR_URL — адрес поднятого сервиса (http:// без домена+TLS,
# https:// если настроили nginx+Let's Encrypt — см. README.md сервиса).
# VPS_EXTRACTOR_TOKEN — тот же случайный секрет, что в .env самого VPS-
# сервиса (EXTRACTOR_AUTH_TOKEN) — авторизует запросы от Vercel к VPS.
VPS_EXTRACTOR_URL=
VPS_EXTRACTOR_TOKEN=

# Relay байтов через VPS (/relay в vps-extractor/src/server.js) для CDN,
# блокирующих IP serverless-платформ (см. RELAY_HOSTS в lib/extract/proxy.ts)
# — переключается НЕ отсюда, а живым флагом в БД (миграция 0013,
# lib/settings.ts) через профиль → админ-панель, без редеплоя.

# OpenSubtitles — внешние субтитры для аниме и сериалов кино (Videoseed
# отдаёт свои .vtt только для части фильмов, см. lib/subtitles/opensubtitles.ts).
# API-ключ из личного кабинета opensubtitles.com (Api Consumers) — НЕ .org,
# это разные сервисы. Бесплатный тариф: 100 скачиваний/сутки НА ВЕСЬ КЛЮЧ,
# поэтому результаты кэшируются навсегда в subtitle_cache (миграция 0012).
# Без ключа субтитры просто не ищутся (для остальных источников это не
# отличается от их отсутствия).
OPENSUBTITLES_API_KEY=

# Sentry — мониторинг ошибок прод (опционально). Зарегистрируйтесь на
# sentry.io (бесплатный тариф), создайте проект (платформа Next.js) и
# возьмите DSN оттуда (Project Settings → Client Keys). NEXT_PUBLIC_-
# префикс намеренный: DSN не секрет, он и так публичен в клиентском бандле
# любого Sentry-проекта. Без переменной SDK просто ничего никуда не шлёт —
# код Sentry уже подключён (см. sentry.*.config.ts), поставить сюда значение
# и передеплоить достаточно, чтобы включить мониторинг.
NEXT_PUBLIC_SENTRY_DSN=

# Опционально: только если хотите читаемые (не минифицированные) стектрейсы
# в Sentry — загрузка сорсмапов при билде. Auth-токен: sentry.io → Settings →
# Auth Tokens (нужен scope project:releases). ORG/PROJECT — слаги из URL
# вашего проекта в Sentry. Без токена билд просто пропускает этот шаг.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

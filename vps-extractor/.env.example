# Порт, на котором слушает сервис (проксируется через nginx/firewall — см. README.md).
PORT=3300

# Секрет для авторизации запросов от Vercel — ЛЮБАЯ случайная строка
# (например: openssl rand -hex 32). Та же строка идёт в Vercel как
# VPS_EXTRACTOR_TOKEN (см. README.md и .env.example основного проекта).
EXTRACTOR_AUTH_TOKEN=

# RU-прокси для обхода гео-блока Alloha (/bnsi/movies/{id}), SOCKS5, без
# логина/пароля в самом URL. НЕ ТРЕБУЕТСЯ, пока эта VPS сама с российским
# IP (проверено вживую 2026-08-30: полное Puppeteer-извлечение Alloha,
# включая /bnsi/, проходит без прокси вообще — см. src/browser.js/alloha.js,
# где ALLOHA_PROXY_SERVER не задан просто отключает PAC-роутинг на Alloha и
# весь трафик идёт напрямую). Заполнять только если сервис снова переедет
# на инфраструктуру с не-российским IP.
ALLOHA_PROXY_SERVER=
ALLOHA_PROXY_USERNAME=
ALLOHA_PROXY_PASSWORD=

# Те же значения, что уже стоят в Vercel для основного сайта.
VIDEOSEED_TOKEN=
VIDEOSEED_HOST=
